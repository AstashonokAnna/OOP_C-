<Window x:Class="AdoreFlowerShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AdoreFlowerShop.Converters"
        xmlns:mvvm="clr-namespace:AdoreFlowerShop.Mvvm"
        Title="{DynamicResource AppTitle}" Height="520" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

	<Window.Resources>
		<conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
	</Window.Resources>

	<Border Padding="28,24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
	        CornerRadius="2" Margin="12" Background="{DynamicResource CardBackgroundBrush}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="22" FontWeight="SemiBold"
			           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
			<TextBlock Grid.Row="1" Text="{Binding PrimaryHint}" TextWrapping="Wrap" FontSize="12"
			           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" Margin="0,0,0,18"/>

			<TextBlock Grid.Row="2" Text="{DynamicResource LoginDialog_Username}" FontSize="11" FontWeight="SemiBold"
			           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
			<TextBox Grid.Row="3" x:Name="UsernameBox"
			         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
			         MaxLength="32"
			         Margin="0,0,0,12" Height="38" VerticalContentAlignment="Center"
			         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>

			<TextBlock Grid.Row="4" Text="{DynamicResource LoginDialog_Password}" FontSize="11" FontWeight="SemiBold"
			           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
			<PasswordBox Grid.Row="5" x:Name="PwdBox"
			             MaxLength="64"
			             mvvm:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			             Height="38" Margin="0,0,0,12" Padding="8,0"
			             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>

			<StackPanel Grid.Row="6" Margin="0,0,0,8">
				<StackPanel.Style>
					<Style TargetType="StackPanel">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</StackPanel.Style>
				<TextBlock Text="{DynamicResource LoginDialog_ConfirmPassword}" FontSize="11" FontWeight="SemiBold"
				           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
				<PasswordBox x:Name="PwdConfirmBox"
				             MaxLength="64"
				             mvvm:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				             Height="38" Padding="8,0"
				             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>

				<TextBlock Text="{DynamicResource LoginDialog_Phone}" FontSize="11" FontWeight="SemiBold"
				           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
				<TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
				         MaxLength="24"
				         Height="38" VerticalContentAlignment="Center" Padding="8,0"
				         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
			</StackPanel>

			<StackPanel Grid.Row="8" Orientation="Vertical">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
					<Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
					        IsCancel="True"
					        Style="{StaticResource ToolBarButton}"
					        MinWidth="108" Height="36" Padding="14,8"/>
					<Button Content="{Binding PrimaryButtonText}"
					        Command="{Binding PrimarySubmitCommand}"
					        IsDefault="True"
					        Style="{StaticResource SaveButton}"
					        MinWidth="148" Height="36" Padding="14,8"/>
				</StackPanel>

				<Button Command="{Binding ShowRegisterCommand}"
				        HorizontalAlignment="Center" Margin="0,14,0,0">
					<Button.Style>
						<Style TargetType="Button" BasedOn="{StaticResource LinkLikeButton}">
							<Setter Property="Visibility" Value="Visible"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
					<TextBlock Text="{DynamicResource LoginDialog_NoAccount}" TextDecorations="Underline"/>
				</Button>

				<Button Command="{Binding ShowLoginCommand}"
				        HorizontalAlignment="Center" Margin="0,10,0,0">
					<Button.Style>
						<Style TargetType="Button" BasedOn="{StaticResource LinkLikeButton}">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
					<TextBlock Text="{DynamicResource LoginDialog_HasAccount}" TextDecorations="Underline"/>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</Window>
