<Window x:Class="AdoreFlowerShop.Views.ReviewDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оставить отзыв" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Ваш отзыв" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Оценка:" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
            <ComboBox x:Name="RatingCombo" Margin="10,0" SelectedIndex="4" Width="80">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>
            <TextBlock Text="из 5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <TextBox Grid.Row="2" x:Name="CommentBox"
                 MaxLength="1000"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Foreground="{DynamicResource TextBrush}"
                 Background="{DynamicResource SurfaceBrush}"
                 Margin="0,0,0,10"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отправить" Click="Submit_Click"
                    Width="110" Margin="5" Padding="10,6"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Отмена" Click="Cancel_Click"
                    Width="110" Margin="5" Padding="10,6"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
