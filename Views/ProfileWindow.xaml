<Window x:Class="AdoreFlowerShop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="650" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
	<Window.Resources>
		<!-- Триггеры для выбора темы/языка (локально для личного кабинета) -->
		<Style TargetType="RadioButton">
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
			<Setter Property="Margin" Value="0,0,25,0"/>

			<Style.Triggers>
				<!-- DataTrigger -->
				<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>

				<!-- MultiTrigger -->
				<MultiTrigger>
					<MultiTrigger.Conditions>
						<Condition Property="IsMouseOver" Value="True"/>
						<Condition Property="IsChecked" Value="False"/>
					</MultiTrigger.Conditions>
					<Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
				</MultiTrigger>

				<!-- EventTrigger -->
				<EventTrigger RoutedEvent="ToggleButton.Checked">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity"
											 From="0.75" To="1" Duration="0:0:0.12"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Личный кабинет" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="14,12" CornerRadius="6"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasRegisteredNotice}" Value="True"/>
                                <Condition Binding="{Binding IsAdmin}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding RegisteredNoticeTitle}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="{Binding RegisteredNoticeDescription}" Margin="0,6,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding RegisteredOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2" Header="Личные данные" Margin="0,5" Padding="10">
            <StackPanel>
                <WrapPanel Margin="0,5">
                    <Label Content="Имя пользователя:" Width="160" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding UserName}" Width="280" IsReadOnly="True"
                             Background="{DynamicResource SurfaceBrush}"/>
                </WrapPanel>
                <WrapPanel Margin="0,5">
                    <Label Content="Телефон:" Width="160" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding UserPhone}" Width="280" IsReadOnly="True"
                             Background="{DynamicResource SurfaceBrush}"/>
                </WrapPanel>
                <WrapPanel Margin="0,5">
                    <Label Content="Новый пароль:" Width="160" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="NewPasswordBox" Width="280" Height="30" MaxLength="64"/>
                </WrapPanel>
                <WrapPanel Margin="0,5">
                    <Label Content="Подтверждение пароля:" Width="160" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Width="280" Height="30" MaxLength="64"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Мои заказы" Margin="0,5" Padding="10">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <Grid>
                <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Товар" Binding="{Binding FlowerName}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding TotalPrice, StringFormat={}{0:F2} $}" Width="90"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="Доставка" Binding="{Binding DeliveryDate}" Width="130"/>
                        <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Тема оформления" Margin="0,5" Padding="10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <RadioButton Content="Светлая" GroupName="Theme" IsChecked="{Binding IsLightTheme}"
                             Margin="0,0,25,0"/>
                <RadioButton Content="Темная" GroupName="Theme" IsChecked="{Binding IsDarkTheme}"/>
            </StackPanel>
        </GroupBox>

        <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,20">
            <Button Content="Сохранить" Click="Save_Click" Width="110" Margin="5" Padding="10,6"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="110" Margin="5" Padding="10,6"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"/>
        </WrapPanel>
    </Grid>
</Window>