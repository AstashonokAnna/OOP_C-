<Window x:Class="AdoreFlowerShop.Views.AdminDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AdoreFlowerShop.Converters"
        Title="Администрирование БД" Height="680" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <conv:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter"/>
        <conv:GridNumberConverter x:Key="GridNumberConverter"/>

        <Style x:Key="AdminGridCellText" TargetType="TextBlock">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="AdminGridCellNumber" TargetType="TextBlock" BasedOn="{StaticResource AdminGridCellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="AdminGridEditNumber" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding DbPathInfo}"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Width="110" Margin="0,0,10,0" Click="Refresh_Click"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Flowers">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Добавить" Width="110" Margin="0,0,10,0" Click="AddFlower_Click"/>
                        <Button Content="Удалить" Width="110" Margin="0,0,10,0" Click="DeleteFlower_Click"/>
                        <Button Content="Сохранить" Width="110" Margin="0,0,10,0" Click="SaveFlower_Click"/>
                        <Button x:Name="PickPhotoButton" Content="Выбрать фото…" Width="130" Click="PickFlowerPhoto_Click"/>
                        <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Сортировка: кликайте по заголовкам столбцов."/>
                    </StackPanel>

                    <DataGrid x:Name="FlowersDataGrid"
                              ItemsSource="{Binding Flowers}"
                              SelectedItem="{Binding SelectedFlower}"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto"
                              ColumnWidth="Auto"
                              MinColumnWidth="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Width="55" SortMemberPath="Id"/>
                            <DataGridTextColumn Header="SortOrder" Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTemplateColumn Header="Фото" Width="80" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="60" Height="60" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding MainImageBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ShortName" Binding="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Price" Width="150" MinWidth="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Price"
                                             Converter="{StaticResource GridNumberConverter}"
                                             ConverterParameter="P"
                                             UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminGridCellNumber}"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource AdminGridEditNumber}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Quantity" Width="120" MinWidth="95">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Quantity"
                                             Converter="{StaticResource GridNumberConverter}"
                                             ConverterParameter="Q"
                                             UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminGridCellNumber}"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource AdminGridEditNumber}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Discount" Width="100" MinWidth="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Discount"
                                             Converter="{StaticResource GridNumberConverter}"
                                             ConverterParameter="D"
                                             UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminGridCellNumber}"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource AdminGridEditNumber}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="InStock"
                                                    Binding="{Binding InStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80"/>
                            <DataGridTextColumn Header="Country" Binding="{Binding Country, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Users">
                <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="55" SortMemberPath="Id"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Orders">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Сохранить статус" Width="140" Margin="0,0,10,0" Click="SaveOrderStatus_Click"/>
                        <Button Content="Заказ зарегистрирован" Width="170" Margin="0,0,10,0" Click="MarkOrderRegistered_Click"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Статус — в таблице. «Заказ зарегистрирован» — уведомление клиенту в личном кабинете."/>
                    </StackPanel>
                    <DataGrid x:Name="OrdersDataGrid"
                              ItemsSource="{Binding Orders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto"
                              ColumnWidth="Auto"
                              MinColumnWidth="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Width="55" SortMemberPath="Id"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Товар" Binding="{Binding FlowerName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Кол-во" IsReadOnly="True" Width="95" MinWidth="75">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Quantity"
                                             Converter="{StaticResource GridNumberConverter}"
                                             ConverterParameter="Q"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminGridCellNumber}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Сумма" IsReadOnly="True" Width="160" MinWidth="130">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="TotalPrice"
                                             Converter="{StaticResource GridNumberConverter}"
                                             ConverterParameter="T"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AdminGridCellNumber}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Уведомление"
                                                    Binding="{Binding IsRegisteredNotice, Mode=OneWay}"
                                                    IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" IsReadOnly="True" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

